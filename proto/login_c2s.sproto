# 登录注册 — 客户端请求协议
#
# 账号密码登录。
# 连接建立后 60 秒内必须调用此协议，否则服务端断开连接。
# 登录成功后返回会话 token，后续请求携带此 token 验证身份。
# 登录失败 5 次后会被临时锁定 300 秒。
login 1 {
	request {
		account 0 : string   # 账号，长度 >= 3
		password 1 : string  # 密码，长度 >= 6
	}
	response {
		ok 0 : boolean
		player_id 1 : integer
		token 2 : string     # 会话 token，32 字符，有效期 24 小时
		nickname 3 : string
		level 4 : integer
	}
}

# 注册新账号。
# 注册成功后自动返回 token，无需再次调用 login。
register 2 {
	request {
		account 0 : string
		password 1 : string
	}
	response {
		ok 0 : boolean
		player_id 1 : integer
	}
}
