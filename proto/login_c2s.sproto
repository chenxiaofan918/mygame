# 登录注册 — 客户端请求协议
login 1 {
	request {
		account 0 : string
		password 1 : string
	}
	response {
		ok 0 : boolean
		player_id 1 : integer
		token 2 : string
		nickname 3 : string
		level 4 : integer
	}
}

register 2 {
	request {
		account 0 : string
		password 1 : string
	}
	response {
		ok 0 : boolean
		player_id 1 : integer
	}
}
