include "config.path"

-- 基础配置
thread = 8
logger = nil
logpath = "./log"
harbor = 0
start = "main.game"
bootstrap = "snlua bootstrap"
-- daemon = "./skynet.pid"

-- 游戏服配置
name = "game-server"
port = 8888
max_client = 256
debug_port = 8000

-- 数据库配置（按需启用）
db_host = "127.0.0.1"
db_port = 3306
db_name = "game"
db_user = "root"
db_password = "123456"

-- Redis配置
redis_host = "127.0.0.1"
redis_port = 6379
redis_password = "123456"
