# 游戏协议
.chat 3 {
	request {
		msg 0 : string
	}
	response {
		msg 0 : string
	}
}

.enter_scene 10 {
	request {
		scene_id 0 : integer
	}
	response {
		ok 0 : boolean
	}
}

.move 11 {
	request {
		x 0 : integer
		y 1 : integer
	}
}

# 服务端推送
.chat_notify 10 {
	response {
		player_id 0 : integer
		msg 1 : string
	}
}
